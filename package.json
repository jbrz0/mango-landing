{
  "name": "mango-atlas-market-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsx scripts/build.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "intel:update": "tsx scripts/intel.ts update",
    "intel:validate": "tsx scripts/intel.ts validate",
    "intel:publish": "tsx scripts/publish.ts",
    "gex:update": "tsx scripts/gex.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "^5.11.2",
    "lightweight-charts": "^5.2.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.18.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
